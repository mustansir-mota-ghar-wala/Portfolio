# Copy this file to .env.local and adjust for your machine.
# .env.local files are gitignored on purpose.

# Base URL of the FastAPI backend, WITHOUT a trailing slash.
# Local development:
VITE_API_URL=http://localhost:8000

# When this variable is missing or empty the app silently falls back to the
# bundled data in src/data/portfolioData.js, so the UI always renders.
#
# Production (Vercel): set VITE_API_URL in the Vercel project's
# Settings -> Environment Variables to the deployed backend URL, e.g.
# VITE_API_URL=https://your-portfolio-api.vercel.app
